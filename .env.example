# Copy to .env and set real values. Never commit .env.

# Required for admin login, import, and route management in the app.
# Use a long random string in production.
ADMIN_SECRET=change-me-to-something-secret

# Optional: defaults to local SQLite if unset
# DATABASE_URL=sqlite:///./routesync.db
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname

# Optional: restrict CORS origins (comma-separated). Default: *
# CORS_ORIGINS=https://your-frontend.com
